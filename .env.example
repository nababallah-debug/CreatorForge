# Copiez ce fichier en .env.local uniquement si vous configurez réellement les services correspondants.
# Ne commitez jamais .env.local ni de clé secrète.

# À renseigner uniquement lorsque la base PostgreSQL est configurée :
DATABASE_URL=

# À ajouter plus tard côté serveur uniquement pour un fournisseur IA :
# AI_PROVIDER_API_KEY=

# À ajouter plus tard après configuration officielle des paiements :
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
